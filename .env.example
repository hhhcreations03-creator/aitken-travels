# Public site URL used for canonical links, sitemap, emails and calendar links.
NEXT_PUBLIC_SITE_URL=https://www.thelavishhaven.com

# ---- Online booking ----
# Postgres connection. Added automatically by the Vercel Neon integration.
# For local development without a server: DATABASE_URL=pglite:./.data/pglite
DATABASE_URL=

# Admin login at /admin. Create the hash and secrets with: npm run admin:password
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Protects the daily calendar sync endpoint called by Vercel Cron.
CRON_SECRET=

# ---- Email (optional) ----
# When set, guests and the hotel get booking emails. Without them, bookings
# still work and the admin can contact guests by WhatsApp or email links.
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# ENQUIRY_TO=hello@thelavishhaven.com
